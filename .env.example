# Crée ton propre projet Supabase (https://supabase.com), applique la migration
# dans supabase/migrations/, puis renseigne ces valeurs (Project Settings > API)
# dans un fichier .env à la racine (non commité).
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
